            <div class="gift-img" id="gift-img-genius"></div>
        </div>
        
        <div class="gift-section">
            <h2 class="gift-title">You when you see someone annoys you</h2>
            <div class="gift-img" id="gift-img-badass"></div>
        </div>
        
         <div class="gift-section">
            <h2 class="gift-title">You pretending you don't care</h2>
            <div class="gift-img" id="gift-img-cheers"></div>
        </div>

        <div class="gift-section">
            <h2 class="gift-title">You when you say: JUST ONE MORE BITE</h2>
            <div class="gift-img" id="gift-img-cheers"></div>
        </div>
        
        <div id="story">
            <h1>THINGS I LOVE ABOUT YOU</h1>
        </div>        

        <div class="gift-section">
            <h2 class="gift-title">Your energy</h2>
            <div class="gift-img" id="gift-img-happy"></div>
        </div>
        
        <div class="gift-section">
            <h2 class="gift-title">Your humor</h2>
            <div class="gift-img" id="gift-img-hot"></div>
        </div>
        
        <div class="gift-section">
            <h2 class="gift-title">Your confidence</h2>
            <div class="gift-img" id="gift-img-genius"></div>
        </div>
        
        <div class="gift-section">
            <h2 class="gift-title">Your kindness</h2>
            <div class="gift-img" id="gift-img-badass"></div>
        </div>
        
         <div class="gift-section">
            <h2 class="gift-title">Your ability to make everything fun</h2>
            <div class="gift-img" id="gift-img-cheers"></div>
        </div>
                
        <div class="gift-section">
            <h2 class="gift-title">The way you show uop for people</h2>
